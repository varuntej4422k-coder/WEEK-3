import 'package:flutter/material.dart';

void main() {
  runApp(const ResponsiveApp());
}

// Detect screen category using width
String getScreenCategory(double width) {
  if (width < 600) {
    return 'Mobile';
  } else if (width < 1024) {
    return 'Tablet';
  } else {
    return 'Desktop';
  }
}

class ResponsiveApp extends StatelessWidget {
  const ResponsiveApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Responsive UI Demo',
      theme: ThemeData(
        colorSchemeSeed: Colors.indigo,
        useMaterial3: true,
      ),
      home: const ResponsiveDashboard(),
    );
  }
}

class ResponsiveDashboard extends StatelessWidget {
  const ResponsiveDashboard({super.key});

  @override
  Widget build(BuildContext context) {
    // Detect screen dimensions and orientation
    final media = MediaQuery.of(context);
    final screenWidth = media.size.width;
    final screenHeight = media.size.height;
    final orientation = media.orientation;

    final category = getScreenCategory(screenWidth);

    final orientationName =
        orientation == Orientation.portrait ? 'Portrait' : 'Landscape';

    return Scaffold(
      appBar: AppBar(
        title: const Text(
          'Responsive Dashboard',
          style: TextStyle(fontWeight: FontWeight.bold),
        ),
        backgroundColor: Colors.indigo,
        foregroundColor: Colors.white,
      ),

      // Rebuild the UI when orientation changes
      body: OrientationBuilder(
        builder: (context, currentOrientation) {
          return LayoutBuilder(
            builder: (context, constraints) {
              final width = constraints.maxWidth;
              final currentCategory = getScreenCategory(width);

              final currentOrientationName =
                  currentOrientation == Orientation.portrait
                      ? 'Portrait'
                      : 'Landscape';

              final isDesktop = width >= 1024;
              final isTablet = width >= 600 && width < 1024;

              final int columns = isDesktop
                  ? 3
                  : isTablet
                      ? 2
                      : 1;

              return Column(
                children: [
                  // Screen information
                  Container(
                    width: double.infinity,
                    padding: const EdgeInsets.all(12),
                    color: Colors.indigo.shade50,
                    child: Column(
                      children: [
                        Text(
                          '$currentCategory $currentOrientationName',
                          style: const TextStyle(
                            fontSize: 18,
                            fontWeight: FontWeight.bold,
                            color: Colors.indigo,
                          ),
                        ),
                        const SizedBox(height: 4),
                        Text(
                          'Screen: ${screenWidth.toStringAsFixed(0)} × '
                          '${screenHeight.toStringAsFixed(0)}',
                        ),
                        Text(
                          'Active Layout: $columns column(s)',
                        ),
                      ],
                    ),
                  ),

                  // Header
                  Container(
                    width: double.infinity,
                    margin: const EdgeInsets.all(12),
                    padding: const EdgeInsets.all(16),
                    decoration: BoxDecoration(
                      color: Colors.blue.shade100,
                      borderRadius: BorderRadius.circular(12),
                    ),
                    child: const Text(
                      'Dashboard Header',
                      textAlign: TextAlign.center,
                      style: TextStyle(
                        fontSize: 20,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                  ),

                  // Responsive content area
                  Expanded(
                    child: Row(
                      children: [
                        // Desktop navigation rail
                        if (isDesktop)
                          NavigationRail(
                            selectedIndex: 0,
                            onDestinationSelected: (index) {},
                            labelType: NavigationRailLabelType.all,
                            destinations: const [
                              NavigationRailDestination(
                                icon: Icon(Icons.dashboard),
                                label: Text('Home'),
                              ),
                              NavigationRailDestination(
                                icon: Icon(Icons.bar_chart),
                                label: Text('Reports'),
                              ),
                              NavigationRailDestination(
                                icon: Icon(Icons.settings),
                                label: Text('Settings'),
                              ),
                            ],
                          ),

                        // Cards adapt to available width
                        Expanded(
                          child: Padding(
                            padding: const EdgeInsets.all(8),
                            child: GridView.builder(
                              itemCount: 3,
                              gridDelegate:
                                  SliverGridDelegateWithFixedCrossAxisCount(
                                crossAxisCount: columns,
                                crossAxisSpacing: 12,
                                mainAxisSpacing: 12,
                                childAspectRatio: isDesktop
                                    ? 1.1
                                    : currentOrientation ==
                                            Orientation.landscape &&
                                        !isDesktop
                                    ? 1.2
                                    : 1.5,
                              ),
                              itemBuilder: (context, index) {
                                final titles = [
                                  'Profile',
                                  'Analytics',
                                  'Notifications',
                                ];

                                final icons = [
                                  Icons.person,
                                  Icons.analytics,
                                  Icons.notifications,
                                ];

                                final colors = [
                                  Colors.orange.shade100,
                                  Colors.green.shade100,
                                  Colors.purple.shade100,
                                ];

                                return LayoutBuilder(
                                  builder: (context, cardConstraints) {
                                    return Card(
                                      color: colors[index],
                                      elevation: 3,
                                      child: Padding(
                                        padding: const EdgeInsets.all(12),
                                        child: Column(
                                          mainAxisAlignment:
                                              MainAxisAlignment.center,
                                          children: [
                                            Icon(
                                              icons[index],
                                              size: cardConstraints.maxWidth *
                                                  0.20,
                                            ),
                                            const SizedBox(height: 12),
                                            Flexible(
                                              child: Text(
                                                titles[index],
                                                textAlign: TextAlign.center,
                                                style: const TextStyle(
                                                  fontSize: 18,
                                                  fontWeight: FontWeight.bold,
                                                ),
                                              ),
                                            ),
                                            const SizedBox(height: 8),
                                            const Flexible(
                                              child: Text(
                                                'Responsive content card',
                                                textAlign: TextAlign.center,
                                              ),
                                            ),
                                          ],
                                        ),
                                      ),
                                    );
                                  },
                                );
                              },
                            ),
                          ),
                        ),
                      ],
                    ),
                  ),

                  // Footer
                  Container(
                    width: double.infinity,
                    padding: const EdgeInsets.all(16),
                    color: Colors.indigo,
                    child: const Text(
                      'Dashboard Footer',
                      textAlign: TextAlign.center,
                      style: TextStyle(
                        color: Colors.white,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                  ),
                ],
              );
            },
          );
        },
      ),
    );
  }
}
